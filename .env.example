# FHC — Supabase client keys (frontend safe)
# Copy this file to .env and fill in your Supabase project values.
#
# Where to find these:
#   Supabase Dashboard → your project → Settings → API
#   - Project URL        → "Project URL"
#   - anon public key    → "anon" (this is the key clients can safely use)
#
# IMPORTANT:
#   - NEVER use the `service_role` key in frontend code.
#   - NEVER commit real values to the repository (.env is git-ignored).

VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudinary — UNSIGNED uploads (profile pictures + gallery media)
# Where to find these:
#   Cloudinary Dashboard → Settings → Cloud / Upload
#   - cloud name       → "Cloud name"
#   - unsigned preset  → Settings → Upload → "Add upload preset"
#     * Signing Mode = Unsigned   (never Signed here)
#     * Optional: Folder = fhc/avatars  or fhc/gallery (code also pins path)
#     * Enable "Delete uploaded images" on the preset so the archive can
#       remove assets when an admin deletes a photo (no orphaned files).
# IMPORTANT:
#   - NEVER add VITE_CLOUDINARY_API_SECRET / api_secret here or anywhere
#     in frontend code. An unsigned preset needs NO secret.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name-here
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-here