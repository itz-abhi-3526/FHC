# FHC — Supabase client keys (frontend safe)
# Copy this file to .env and fill in your Supabase project values.
#
# Where to find these:
#   Supabase Dashboard → your project → Settings → API
#   - Project URL        → "Project URL"
#   - anon public key    → "anon" (this is the key clients can safely use)
#
# IMPORTANT:
#   - NEVER use the `service_role` key in frontend code.
#   - NEVER commit real values to the repository (.env is git-ignored).

VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here